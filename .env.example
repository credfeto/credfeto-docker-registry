# Copy this file to .env and adjust the values for the host.

# Shared secret the registry uses to sign state; use the same random value on
# every registry instance behind a load balancer.
REGISTRY_HTTP_SECRET=change-me

# Watchtower update schedule: 6-field cron with seconds first
# (second minute hour day month weekday). Defaults to "0 18 * * * *"
# (hourly at 18 minutes past the hour) when unset. Override it to stagger
# updates across hosts.
# WATCHTOWER_SCHEDULE="0 18 * * * *"
