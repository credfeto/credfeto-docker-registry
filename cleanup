#!/bin/bash

pacman -S --noconfirm jq curl

# Configuration
KEEP_LAST_N=3
DRY_RUN=false
REGISTRY_UID="$(id -u registry 2>/dev/null)" || { echo "ERROR: registry user not found; run the update script first" >&2; exit 1; }

# Function to get tags for a repository
get_tags() {
    local repo=$1
    local registry_url=$2
    local tags_json
    if tags_json=$(curl -sf "$registry_url/v2/$repo/tags/list") && [ -n "$tags_json" ]; then
        echo "$tags_json" | jq -r '.tags[]?' 2>/dev/null || echo ""
    else
        echo ""
    fi
}

# Function to get manifest digest
get_digest() {
    local repo=$1
    local tag=$2
    local registry_url=$3
    local digest
    digest=$(curl -sf -I \
        -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
        "$registry_url/v2/$repo/manifests/$tag" | grep Docker-Content-Digest | awk '{print $2}' | tr -d $'\r')
    echo "$digest"
}

# Function to delete a tag
delete_tag() {
    local repo=$1
    local digest=$2
    local registry_url=$3
    if [ "$DRY_RUN" = true ]; then
        echo "Would delete: $repo@$digest"
    else
        echo "Deleting: $repo@$digest"
        curl -sf -X DELETE  \
            "$registry_url/v2/$repo/manifests/$digest"
    fi
}

cleanup_registry() {
    local registry_url=$1
    local container_name=$2

    echo "Starting cleanup for ${registry_url}..."

    # Process each repository
    for repo in $(curl -sf  "$registry_url/v2/_catalog" | jq -r '.repositories[]'); do
        echo "Processing repository: $repo"
        tags_output=$(get_tags "$repo" "$registry_url")

        if [ -z "$tags_output" ]; then
            continue
        fi

        readarray -t tags < <(echo "$tags_output" | sort -V)
        total_tags=${#tags[@]}

        if [ "$total_tags" -gt $KEEP_LAST_N ]; then
            to_delete=$((total_tags - KEEP_LAST_N))
            echo "Found $total_tags tags, keeping last $KEEP_LAST_N, will delete $to_delete"

            for ((i=0; i<to_delete; i++)); do
                tag=${tags[$i]}
                digest=$(get_digest "$repo" "$tag" "$registry_url")

                if [ -n "$digest" ]; then
                    delete_tag "$repo" "$digest" "$registry_url"
                fi
            done
        fi
    done

    echo "Cleanup process completed for ${registry_url}"

    if [ "$DRY_RUN" = false ]; then
        echo "Running garbage collection on ${container_name}..."
        # flock serialises concurrent invocations of this cleanup script; it
        # does NOT prevent concurrent GC from the compose-managed registry-gc
        # container (which runs inside its own namespace with no access to
        # this host-side lockfile).
        if ! flock --nonblock "/var/lock/registry-gc-${container_name}.lock" \
            sudo -u registry \
                XDG_RUNTIME_DIR="/run/user/${REGISTRY_UID}" \
                podman exec "${container_name}" /bin/registry garbage-collect --delete-untagged /etc/docker/registry/config.yml
        then
            echo "ERROR: garbage collection failed for ${container_name} (lock held by another process, or podman exec error)" >&2
            return 1
        fi
    fi
}

exit_code=0
cleanup_registry "http://localhost:8080" "registry" || exit_code=$?
cleanup_registry "http://localhost:8081" "cache" || exit_code=$?
exit "${exit_code}"
