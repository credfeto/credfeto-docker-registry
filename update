#! /bin/sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
case "${SCRIPT_DIR}" in
    *[[:space:]]*) echo "ERROR: SCRIPT_DIR must not contain whitespace (path: ${SCRIPT_DIR})" >&2; exit 1;;
    *%*)           echo "ERROR: SCRIPT_DIR must not contain '%' — systemd interprets it as a specifier (path: ${SCRIPT_DIR})" >&2; exit 1;;
esac

git -C "${SCRIPT_DIR}" pull || { echo "ERROR: git pull failed; aborting to avoid deploying stale files" >&2; exit 1; }

[ -d /data/registry ] || sudo mkdir -p /data/registry
[ -d /data/cache ] || sudo mkdir -p /data/cache

sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="10.0.0.0/8" port protocol="tcp" port="8080" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="192.168.0.0/16" port protocol="tcp" port="8080" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="172.16.0.0/12" port protocol="tcp" port="8080" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="10.0.0.0/8" port protocol="tcp" port="8081" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="192.168.0.0/16" port protocol="tcp" port="8081" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="172.16.0.0/12" port protocol="tcp" port="8081" accept'

sudo firewall-cmd --reload

# Create a dedicated unprivileged system user to run the registry services
if ! id -u registry > /dev/null 2>&1; then
    sudo useradd --system --create-home --home-dir /var/lib/registry --shell /sbin/nologin registry
fi

REGISTRY_UID="$(id -u registry 2>/dev/null)" || { echo "ERROR: could not resolve registry UID after useradd" >&2; exit 1; }

# Enable lingering so the Podman runtime persists without an active login session
sudo loginctl enable-linger registry

# Allow XDG_RUNTIME_DIR and DBUS_SESSION_BUS_ADDRESS to pass through sudo's
# env_reset when running commands as the registry user; without this entry the
# default env_keep list strips those variables before podman sees them.
printf 'Defaults>registry env_keep += "XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS"\nDefaults>registry setenv\n' | \
    sudo tee /etc/sudoers.d/10-registry-env > /dev/null
sudo chmod 440 /etc/sudoers.d/10-registry-env

# Grant the registry user ownership of the bind-mount source directories
sudo chown registry:registry /data/registry /data/cache

# Allow only the registry user to traverse SCRIPT_DIR; setfacl is preferred to
# avoid making the directory world-readable (chmod o+rx exposes .git/ etc. to
# all local users).
if command -v setfacl > /dev/null 2>&1 && sudo setfacl -m u:registry:rx "${SCRIPT_DIR}" 2>/dev/null; then
    :
else
    sudo chmod o+rx "${SCRIPT_DIR}"
fi

# Create Podman named volumes as the registry user
sudo -u registry \
    XDG_RUNTIME_DIR="/run/user/${REGISTRY_UID}" \
    podman volume create \
        --opt type=none \
        --opt o=bind \
        --opt device=/data/registry \
        registry-data || true
_reg_device=$(sudo -u registry \
    XDG_RUNTIME_DIR="/run/user/${REGISTRY_UID}" \
    podman volume inspect registry-data --format '{{index .Options "device"}}' 2>/dev/null) || {
    echo "ERROR: registry-data volume not available — re-run this script once the registry user session is active (check: loginctl status registry)" >&2
    exit 1
}
if [ "${_reg_device}" != "/data/registry" ]; then
    echo "ERROR: registry-data volume exists but uses device '${_reg_device}' instead of '/data/registry' — remove it with: sudo -u registry XDG_RUNTIME_DIR=/run/user/${REGISTRY_UID} podman volume rm registry-data" >&2
    exit 1
fi

sudo -u registry \
    XDG_RUNTIME_DIR="/run/user/${REGISTRY_UID}" \
    podman volume create \
        --opt type=none \
        --opt o=bind \
        --opt device=/data/cache \
        registry-cache-data || true
_cache_device=$(sudo -u registry \
    XDG_RUNTIME_DIR="/run/user/${REGISTRY_UID}" \
    podman volume inspect registry-cache-data --format '{{index .Options "device"}}' 2>/dev/null) || {
    echo "ERROR: registry-cache-data volume not available — re-run this script once the registry user session is active (check: loginctl status registry)" >&2
    exit 1
}
if [ "${_cache_device}" != "/data/cache" ]; then
    echo "ERROR: registry-cache-data volume exists but uses device '${_cache_device}' instead of '/data/cache' — remove it with: sudo -u registry XDG_RUNTIME_DIR=/run/user/${REGISTRY_UID} podman volume rm registry-cache-data" >&2
    exit 1
fi

# Provision the secrets file for the systemd service
SECRETS_FILE="/etc/registry/secrets.env"
if [ -n "${REGISTRY_HTTP_SECRET:-}" ]; then
    case "${REGISTRY_HTTP_SECRET}" in
        *"
"*) echo "ERROR: REGISTRY_HTTP_SECRET must not contain newlines" >&2; exit 1;;
    esac
    sudo mkdir -p /etc/registry
    printf 'REGISTRY_HTTP_SECRET=%s\n' "${REGISTRY_HTTP_SECRET}" | sudo tee "${SECRETS_FILE}" > /dev/null
    sudo chmod 600 "${SECRETS_FILE}"
    sudo chown registry:registry "${SECRETS_FILE}"
elif [ ! -f "${SECRETS_FILE}" ]; then
    echo "ERROR: REGISTRY_HTTP_SECRET is not set and ${SECRETS_FILE} does not exist." >&2
    echo "       Set REGISTRY_HTTP_SECRET in your environment and re-run, or create ${SECRETS_FILE} manually." >&2
    exit 1
fi

# Pull updated images before restarting
sudo -u registry \
    XDG_RUNTIME_DIR="/run/user/${REGISTRY_UID}" \
    podman compose --project-directory "${SCRIPT_DIR}" pull || {
    echo "ERROR: podman compose pull failed; aborting service restart to avoid starting with stale images." >&2
    exit 1
}

# Install or update the system-level systemd service unit
sudo tee /etc/systemd/system/podman-registry.service << EOF > /dev/null || { echo "ERROR: failed to write systemd unit file" >&2; exit 1; }
[Unit]
Description=Container Registry Stack (rootless Podman Compose)
After=network-online.target user@${REGISTRY_UID}.service
Wants=network-online.target

[Service]
Type=exec
User=registry
Group=registry
WorkingDirectory=${SCRIPT_DIR}
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=HOME=/var/lib/registry
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
EnvironmentFile=-${SECRETS_FILE}
ExecStartPre=/bin/sh -c 'test -f ${SECRETS_FILE} || { echo "FATAL: ${SECRETS_FILE} is missing -- re-run the update script with REGISTRY_HTTP_SECRET set" >&2; exit 1; }'
ExecStart=/usr/bin/podman compose --project-directory ${SCRIPT_DIR} up --remove-orphans
ExecStop=/usr/bin/podman compose --project-directory ${SCRIPT_DIR} down
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload || { echo "ERROR: systemctl daemon-reload failed; the unit file may be malformed" >&2; exit 1; }
sudo systemctl enable podman-registry.service || { echo "ERROR: systemctl enable failed" >&2; exit 1; }
sudo systemctl restart podman-registry.service || { echo "ERROR: systemctl restart failed; check: journalctl -u podman-registry.service" >&2; exit 1; }
