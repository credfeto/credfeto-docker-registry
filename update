#! /bin/sh

# sh has already parsed this script, so changes the pull brings to it would
# only take effect on the next run. Re-run the freshly pulled copy once.
if [ "${UPDATE_ALREADY_PULLED:-}" != "1" ]; then
    git pull
    UPDATE_ALREADY_PULLED=1 exec "$(readlink -f "$0")" "$@"
fi

[ -d /data/registry ] || sudo mkdir -p /data/registry
[ -d /data/cache ] || sudo mkdir -p /data/cache

sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="10.0.0.0/8" port protocol="tcp" port="8008" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="192.168.0.0/16" port protocol="tcp" port="8080" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="172.16.0.0/12" port protocol="tcp" port="8080" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="10.0.0.0/8" port protocol="tcp" port="8081" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="192.168.0.0/16" port protocol="tcp" port="8081" accept'
sudo firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="172.16.0.0/12" port protocol="tcp" port="8081" accept'

sudo firewall-cmd --reload
sudo docker volume create \
  --opt type=none \
  --opt o=bind \
  --opt device=/data/registry \
  registry-data

sudo docker volume create \
  --opt type=none \
  --opt o=bind \
  --opt device=/data/cache \
  registry-cache-data

sudo docker compose pull && sudo docker compose up -d --remove-orphans

# Ingress/egress lockdown (nftables + firewalld policies); observation mode
# unless REGISTRY_FIREWALL_ENFORCE=true in .env. Runs after the containers
# exist, because Docker creates the docker zone the policies refer to. See
# README.md, "Host firewall".
sudo "$(dirname "$(readlink -f "$0")")/firewall/configure" || exit 1
